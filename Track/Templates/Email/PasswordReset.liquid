---
subject: Reset your Track password
---
{% layout '_layout.liquid' %}

<tr><td class="section">
<div class="body-text">
  <h1 class="heading">Reset your password</h1>
  <p>A password reset was requested for your Track account, <strong>{{ userName }}</strong>.</p>

  <table role="presentation" cellpadding="0" cellspacing="0" border="0" class="button-spaced">
  <tr><td class="button"><a href="{{ link }}">Reset password</a></td></tr>
  </table>

  <p class="muted">The link works once, for {{ linkValidHours }} hours. If you didn't ask for this, ignore this email and your password stays the same.</p>
  <p class="muted">If the button doesn't work, paste this link into your browser:</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="link-fallback">{{ link }}</td></tr></table>
</div>
</td></tr>
