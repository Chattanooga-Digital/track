<!DOCTYPE html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>{{ subject }}</title>
  <!--[if mso]>
  <noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>
  <![endif]-->
  <style>
    body { -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; margin:0; padding:0; background-color:#eef1f6; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; color:#171a21; }
    table, td { mso-table-lspace:0pt; mso-table-rspace:0pt; }

    .email-bg { background-color:#eef1f6; }
    .email-outer { padding:24px 12px; }
    .email-frame { max-width:600px; background-color:#ffffff; border-radius:10px; overflow:hidden; }

    .accent { height:3px; line-height:3px; font-size:0; background:#2196f3; }
    .header { padding:18px 26px; border-bottom:1px solid #e6e9f0; font-size:18px; font-weight:700; color:#1c2a46; }
    .section { padding:28px 26px; }
    .footer { padding:16px 26px; border-top:1px solid #e6e9f0; font-size:12px; color:#8a93a6; line-height:1.5; }

    .heading { font-size:19px; font-weight:700; color:#1c2a46; margin:0 0 14px; }
    .body-text { font-size:15px; line-height:1.6; color:#2b3550; }
    .body-text p { margin:0 0 16px; }
    .body-text a { color:#2196f3; text-decoration:underline; }

    .button-spaced { margin:4px 0 20px; }
    .button { background-color:#2196f3; border-radius:7px; padding:12px 26px; }
    .button a { display:inline-block; color:#ffffff; font-size:14px; font-weight:600; text-decoration:none; }

    .muted { font-size:13px; color:#49536b; }
    .link-fallback { font-size:12px; color:#49536b; word-break:break-all; background:#f3f5fa; border:1px solid #e6e9f0; border-radius:6px; padding:9px 11px; font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; }

    .callout { border-left:3px solid #f0b429; background:#fdf6e6; padding:12px 14px; border-radius:0 8px 8px 0; font-size:13.5px; color:#6a5011; }
  </style>
</head>
<body class="email-bg">

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="email-bg">
<tr><td align="center" class="email-outer">

<!--[if mso]><table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="email-frame">

<tr><td class="accent">&nbsp;</td></tr>
<tr><td class="header">Track</td></tr>

{% renderbody %}

<tr><td class="footer">Sent by Track.</td></tr>

</table>
<!--[if mso]></td></tr></table><![endif]-->
</td></tr>
</table>
</body>
</html>
