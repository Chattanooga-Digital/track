---
subject: Set up your Track account
---
{% layout '_layout.liquid' %}

<tr><td class="section">
<div class="body-text">
  <h1 class="heading">Set your password</h1>
  {% if sentBy %}
  <p>{{ sentBy }} added you to Track. Your username is <strong>{{ userName }}</strong>.</p>
  {% else %}
  <p>You have a Track account. Your username is <strong>{{ userName }}</strong>.</p>
  {% endif %}

  <table role="presentation" cellpadding="0" cellspacing="0" border="0" class="button-spaced">
  <tr><td class="button"><a href="{{ link }}">Set password</a></td></tr>
  </table>

  <p class="muted">The link works once, for {{ linkValidHours }} hours. If it runs out, ask an administrator to send another.</p>
  <p class="muted">If the button doesn't work, paste this link into your browser:</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="link-fallback">{{ link }}</td></tr></table>
</div>
</td></tr>
