    <ImplicitUsings>enable</ImplicitUsings>
    <VersionPrefix>0.10.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
