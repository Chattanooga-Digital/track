{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=track.db"
  },
  "Track": {
    "PollIntervalSeconds": 15,
    "DiskPollIntervalSeconds": 300,
    "RetentionDays": 14,
    "CorsOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ],
    "Nodes": [
      {
        "Name": "local",
        "Endpoint": "unix:///var/run/docker.sock"
      }
    ]
  }
}
